# FrameGenX environment template — copy to .env and fill in real values.
# NEVER commit .env (real keys). This file must only ever contain placeholders.
#
# Model download/cache behavior
HF_HUB_ENABLE_HF_TRANSFER=0
HF_HUB_DOWNLOAD_TIMEOUT=120
MAX_CONCURRENCY=2

# Local API defaults to loopback. Set these only for an explicitly secured deployment.
# FRAMEGENX_HOST=127.0.0.1
# FRAMEGENX_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# PyTorch allocator: expandable segments are UNSTABLE under WSL2 GPU
# passthrough (see docker-compose.yml) — native Windows runs may keep it.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Local HuggingFace cache (big — put it on a roomy drive)
HF_HOME=E:\hf_cache

# LLM router keys (src/core/llm_router.py). At least ONE is required for
# intent extraction + VQA; all are optional-but-recommended.
GROQ_API_KEY=gsk_your_groq_key_here
GOOGLE_AI_STUDIO_API_KEY=your_google_ai_studio_key_here
NVIDIA_NIM_KEY=nvapi-your_nvidia_nim_key_here
OPENROUTER_API_KEY=sk_or_your_openrouter_key_here

# Optional: per-provider model overrides (defaults live in llm_router.py,
# verified against live catalogs 2026-08-23)
# LLM_MODEL_GROQ=openai/gpt-oss-120b
# LLM_MODEL_NVIDIA=meta/llama-3.3-70b-instruct
# LLM_MODEL_GEMINI=gemini-flash-latest
# LLM_TIMEOUT_SECONDS=30
